```html
<!-- Before -->
        </tbody>
      </table>
    </section>
    <!-- endregion:deviations -->
```
```html
<!-- After -->
          <tr>
            <td><code>INV-05</code></td>
            <td>Spec said X</td>
            <td>Actually did Y</td>
            <td>Reason for the change.</td>
          </tr>
        </tbody>
